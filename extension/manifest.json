{
  "manifest_version": 3,
  "name": "Word Explainer",
  "version": "0.4.4",
  "description": "Pronounce, translate, or ask ChatGPT or Gemini about selected text.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "contextMenus",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "review-panel.js",
        "equation-speech.js",
        "highlighter.js",
        "notes-anchor.js",
        "notes-panel.js",
        "content.js"
      ],
      "exclude_matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chat-cleanup.js",
        "chatgpt-worker.js",
        "equation-speech.js",
        "highlighter.js",
        "notes-anchor.js",
        "notes-panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "chat-cleanup.js",
        "gemini-worker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://storage.googleapis.com/cloud-training/*"
      ],
      "js": [
        "course-selection.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "show-selection-menu": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Show actions for selected text"
    }
  },
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "pdf-panel.html"
  }
}
