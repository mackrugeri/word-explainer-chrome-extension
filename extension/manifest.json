{
  "manifest_version": 3,
  "name": "Word Explainer",
  "version": "0.4.49",
  "description": "Pronounce, translate, or ask ChatGPT or Gemini about selected text.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen",
    "contextMenus",
    "sidePanel",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "theme.js",
        "ui-icons.js",
        "review-panel.js",
        "rich-response.js",
        "equation-speech.js",
        "highlighter.js",
        "notes-anchor.js",
        "notes-panel.js",
        "math-selection.js",
        "selection-launcher.js",
        "page-references.js",
        "selection-references.js",
        "reading-progress.js",
        "focus-reading.js",
        "floating-tools.js",
        "selection-history.js",
        "followup.js",
        "content.js"
      ],
      "exclude_matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://storage.googleapis.com/cloud-training/*",
        "https://www.skills.google/*",
        "https://skills.google/*"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "theme.js",
        "ui-icons.js",
        "review-panel.js",
        "chat-cleanup.js",
        "rich-response.js",
        "chatgpt-worker.js",
        "equation-speech.js",
        "highlighter.js",
        "notes-anchor.js",
        "notes-panel.js",
        "math-selection.js",
        "selection-launcher.js",
        "page-references.js",
        "selection-references.js",
        "reading-progress.js",
        "focus-reading.js",
        "floating-tools.js",
        "selection-history.js",
        "followup.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "chat-cleanup.js",
        "gemini-worker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://storage.googleapis.com/cloud-training/*"
      ],
      "js": [
        "theme.js",
        "ui-icons.js",
        "review-panel.js",
        "rich-response.js",
        "equation-speech.js",
        "highlighter.js",
        "notes-anchor.js",
        "notes-panel.js",
        "math-selection.js",
        "selection-launcher.js",
        "page-references.js",
        "selection-references.js",
        "reading-progress.js",
        "focus-reading.js",
        "floating-tools.js",
        "course-selection.js",
        "selection-history.js",
        "followup.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.skills.google/*",
        "https://skills.google/*"
      ],
      "js": [
        "theme.js",
        "ui-icons.js",
        "review-panel.js",
        "rich-response.js",
        "equation-speech.js",
        "highlighter.js",
        "notes-anchor.js",
        "notes-panel.js",
        "math-selection.js",
        "selection-launcher.js",
        "page-references.js",
        "selection-references.js",
        "reading-progress.js",
        "focus-reading.js",
        "floating-tools.js",
        "course-selection.js",
        "selection-history.js",
        "followup.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "show-selection-menu": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Show actions for selected text"
    }
  },
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "pdf-panel.html"
  }
}
