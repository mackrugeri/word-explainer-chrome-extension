{
  "manifest_version": 3,
  "name": "Word Explainer",
  "version": "0.1.5",
  "description": "Pronounce selected text or request a short explanation through ChatGPT in an inactive tab.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "exclude_matches": [
        "https://chatgpt.com/*"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-worker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "show-selection-menu": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Show actions for selected text"
    }
  },
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate.google.com/*"
  ],
  "minimum_chrome_version": "116"
}
